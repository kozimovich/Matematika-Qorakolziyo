# Client-side (Vite ga `VITE_` prefiksi bilan o'qiladi, bundle ichiga tushadi)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# Server-side (faqat api/* serverless funksiyalarda ishlatiladi — sirli, mijozga tushmaydi)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# Origin whitelist — vergul bilan ajratilgan, faqat shu domenlardan POST qabul qilinadi
# Bo'sh qoldirilsa, har qanday domen'dan POST kabul qilinadi (production'da to'ldirish shart)
# Misol: https://qorakol-ziyo.uz,https://www.qorakol-ziyo.uz
ALLOWED_ORIGINS=
